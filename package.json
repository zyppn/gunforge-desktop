{
  "name": "gunforge",
  "productName": "GUNFORGE",
  "version": "1.4.56",
  "description": "Arena shooter with persistent loot, part sets and a live auction house",
  "main": "main.js",
  "author": "Jacob Phillips",
  "license": "MIT",
  "scripts": {
    "start": "electron .",
    "dist": "electron-builder",
    "dist:win": "electron-builder --win",
    "dist:mac": "electron-builder --mac",
    "dist:linux": "electron-builder --linux",
    "sync:core": "node -e \"require('fs').copyFileSync('server/loadout-core.js','renderer/vendor/loadout-core.js')\"",
    "prestart": "npm run sync:core",
    "predist": "npm run sync:core",
    "predist:win": "npm run sync:core",
    "predist:mac": "npm run sync:core",
    "predist:linux": "npm run sync:core"
  },
  "devDependencies": {
    "electron": "^44.2.0",
    "electron-builder": "^26.15.3"
  },
  "build": {
    "appId": "com.zyppn.gunforge",
    "productName": "GUNFORGE",
    "files": [
      "main.js",
      "preload.js",
      "renderer/**/*"
    ],
    "win": {
      "target": "nsis",
      "icon": "build/icon.png"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": false
    },
    "mac": {
      "target": [
        {
          "target": "dmg",
          "arch": [
            "x64",
            "arm64"
          ]
        },
        {
          "target": "zip",
          "arch": [
            "x64",
            "arm64"
          ]
        }
      ],
      "category": "public.app-category.games",
      "icon": "build/icon-mac.png"
    },
    "linux": {
      "target": "AppImage",
      "category": "Game",
      "icon": "build/icon.png"
    },
    "publish": [
      {
        "provider": "github",
        "owner": "zyppn",
        "repo": "gunforge-desktop"
      }
    ]
  },
  "dependencies": {
    "electron-updater": "^6.3.4"
  }
}
